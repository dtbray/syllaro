{
  "name": "syllaro-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "contracts": "../.venv-dashboard/bin/python export_openapi.py && openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
    "test": "playwright test",
    "format": "prettier --write src vite.config.ts playwright.config.ts tests components.json tsconfig.json",
    "format:check": "prettier --check src vite.config.ts playwright.config.ts tests components.json tsconfig.json"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.54.0",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "bits-ui": "2.19.5",
    "cn": "0.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "shadcn-svelte": "1.7.0",
    "svelte-check": "4.7.6",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
