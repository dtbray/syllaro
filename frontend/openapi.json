  "components": {
    "schemas": {
      "Artifact": {
        "properties": {
          "content": {
            "type": "string",
            "title": "Content"
          },
          "format": {
            "type": "string",
            "enum": [
              "text",
              "markdown"
            ],
            "title": "Format"
          }
        },
        "type": "object",
        "required": [
          "content",
          "format"
        ],
        "title": "Artifact"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "execution": {
            "type": "string",
            "title": "Execution",
            "default": "Existing CLI workers; API only enqueues"
          }
        },
        "type": "object",
        "title": "Health"
      },
      "JobList": {
        "properties": {
          "jobs": {
            "items": {
              "$ref": "#/components/schemas/JobView"
            },
            "type": "array",
            "title": "Jobs"
          },
          "queues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Queues"
          },
          "invalid_records": {
            "type": "integer",
            "title": "Invalid Records"
          }
        },
        "type": "object",
        "required": [
          "jobs",
          "queues",
          "invalid_records"
        ],
        "title": "JobList"
      },
      "JobView": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "queue": {
            "type": "string",
            "title": "Queue"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "kind": {
            "type": "string",
            "enum": [
              "youtube",
              "transcript",
              "audio"
            ],
            "title": "Kind"
          },
          "profile": {
            "type": "string",
            "enum": [
              "local",
              "workstation"
            ],
            "title": "Profile"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "running",
              "transcribed",
              "summarizing",
              "done",
              "failed"
            ],
            "title": "Status"
          },
          "created": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created"
          },
          "started": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started"
          },
          "finished": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished"
          },
          "stage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stage"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "artifacts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Artifacts"
          }
        },
        "type": "object",
        "required": [
          "id",
          "queue",
          "title",
          "source",
          "kind",
          "profile",
          "status",
          "artifacts"
        ],
        "title": "JobView"
      },
      "Submission": {
        "properties": {
          "source": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Source"
          },
          "profile": {
            "type": "string",
            "enum": [
              "local",
              "workstation"
            ],
            "title": "Profile",
            "default": "local"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source"
        ],
        "title": "Submission"
      }
    }
  }
}
